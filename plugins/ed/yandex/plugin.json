          "name": "mode",
          "type": "select",
          "default": "toggle",
          "label": {
            "en": "What to do",
            "ru": "Что сделать"
          },
          "options": [
            {
              "value": "toggle",
              "label": {
                "en": "Toggle",
                "ru": "Переключить"
              }
            },
            {
              "value": "play",
              "label": {
                "en": "Play",
                "ru": "Играть"
              }
            },
            {
              "value": "pause",
              "label": {
                "en": "Pause",
                "ru": "Пауза"
              }
            }
